{
  "$schema": "https://opencode.ai/config.json",
  "username": "PrankBox Dev",
  "model": "opencode-go/gpt-5.6-luna",
  "small_model": "opencode/deepseek-v4-flash-free",
  "default_agent": "build",
  "instructions": ["AGENTS.md", "docs/"],
  "share": "manual",
  "autoupdate": "notify",
  "snapshot": true,
  "subagent_depth": 1,
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "git *": "allow",
      "eas *": "allow",
      "expo *": "allow",
      "*": "ask"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "external_directory": {
      "*": "allow"
    }
  },
  "formatter": true,
  "lsp": true,
  "tool_output": {
    "max_lines": 150,
    "max_bytes": 6144
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 8,
    "preserve_recent_tokens": 12000,
    "reserved": 8000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".expo/**",
      "dist/**",
      "web-build/**",
      ".git/**",
      "ios/**",
      "android/**",
      "*.log"
    ]
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 1000,
      "max_height": 1000,
      "max_base64_bytes": 1048576
    }
  },
  "agent": {
    "build": {
      "model": "opencode-go/gpt-5.6-luna",
      "steps": 60,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow"
      }
    },
    "plan": {
      "model": "opencode-go/glm-5.2",
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "read": "allow"
      }
    },
    "bugfix": {
      "model": "opencode-go/gpt-5.6-luna",
      "steps": 20,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow"
      }
    },
    "compaction": {
      "model": "opencode/deepseek-v4-flash-free",
      "steps": 3
    },
    "title": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "summary": {
      "model": "opencode/deepseek-v4-flash-free"
    }
  }
}
